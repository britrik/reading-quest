# Database
DATABASE_URL=postgresql://user:password@localhost:5432/reading_quest

# Server
PORT=8080
NODE_ENV=development

# Grownup Authentication
# Required in production: at least 6 characters; common values such as 1234
# are rejected at startup. Leave blank in development to get a temporary
# random passcode printed in the server log.
GROWNUPS_PASSCODE=
GROWNUPS_TOKEN_SECRET=

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Session cookie signing key (falls back to GROWNUPS_TOKEN_SECRET in dev)
SESSION_SECRET=

# E2E Testing (do not set in production)
# ENABLE_E2E_TEST_ROUTES=true
# E2E_TEST_SECRET=
